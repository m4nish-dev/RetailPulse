# RetailPulse — MySQL connection settings (template)
#
# Copy this file to .env (which is git-ignored) and fill in the values:
#     cp .env.example .env
#
# Use the dedicated read-only application account created by
# sql/10_app_user.sql — NEVER root. Do not commit .env.

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=retailpulse
MYSQL_USER=retailpulse_app
MYSQL_PASSWORD=change-me
