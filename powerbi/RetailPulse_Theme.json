{
  "name": "RetailPulse Dark",
  "dataColors": [
    "#D95926", "#3987E5", "#199E70", "#C98500", "#D55181",
    "#008300", "#9085E9", "#E66767"
  ],
  "background": "#1A1A19",
  "foreground": "#F0EFEC",
  "tableAccent": "#D95926",
  "good": "#199E70",
  "neutral": "#C98500",
  "bad": "#E66767",
  "maximum": "#D95926",
  "center": "#C3C2B7",
  "minimum": "#2B2B29",
  "textClasses": {
    "title":      { "fontFace": "Segoe UI Semibold", "fontSize": 15, "color": "#F0EFEC" },
    "header":     { "fontFace": "Segoe UI Semibold", "fontSize": 12, "color": "#F0EFEC" },
    "label":      { "fontFace": "Segoe UI",          "fontSize": 10, "color": "#C3C2B7" },
    "callout":    { "fontFace": "Segoe UI Semibold", "fontSize": 36, "color": "#F0EFEC" },
    "largeTitle": { "fontFace": "Segoe UI Semibold", "fontSize": 20, "color": "#F0EFEC" }
  },
  "visualStyles": {
    "*": {
      "*": {
        "background":  [{ "show": true, "color": { "solid": { "color": "#232321" } }, "transparency": 0 }],
        "border":      [{ "show": true, "color": { "solid": { "color": "#34332F" } }, "radius": 6 }],
        "visualHeader":[{ "show": true, "background": { "solid": { "color": "#232321" } },
                          "foreground": { "solid": { "color": "#C3C2B7" } } }],
        "title": [{ "show": true, "fontColor": { "solid": { "color": "#F0EFEC" } },
                    "background": { "solid": { "color": "#232321" } },
                    "fontSize": 13, "fontFamily": "Segoe UI Semibold", "alignment": "left" }],
        "labels": [{ "color": { "solid": { "color": "#C3C2B7" } }, "fontSize": 9 }],
        "categoryAxis": [{ "showAxisTitle": true,
                           "labelColor": { "solid": { "color": "#C3C2B7" } },
                           "gridlineShow": false,
                           "lineColor": { "solid": { "color": "#34332F" } } }],
        "valueAxis":    [{ "showAxisTitle": true,
                           "labelColor": { "solid": { "color": "#C3C2B7" } },
                           "gridlineShow": true,
                           "gridlineColor": { "solid": { "color": "#2E2D2A" } },
                           "gridlineThickness": 1,
                           "lineColor": { "solid": { "color": "#34332F" } } }],
        "legend": [{ "show": true, "position": "TopCenter",
                     "labelColor": { "solid": { "color": "#C3C2B7" } },
                     "fontSize": 9, "showTitle": false }]
      }
    },
    "card": {
      "*": {
        "labels":         [{ "color": { "solid": { "color": "#F0EFEC" } }, "fontSize": 30,
                             "fontFamily": "Segoe UI Semibold" }],
        "categoryLabels": [{ "show": true, "color": { "solid": { "color": "#C3C2B7" } },
                             "fontSize": 10 }],
        "background":     [{ "show": true, "color": { "solid": { "color": "#232321" } } }],
        "border":         [{ "show": true, "color": { "solid": { "color": "#D95926" } }, "radius": 6 }]
      }
    },
    "slicer": {
      "*": {
        "header": [{ "show": true, "fontColor": { "solid": { "color": "#F0EFEC" } },
                     "background": { "solid": { "color": "#232321" } }, "fontSize": 10 }],
        "items":  [{ "fontColor": { "solid": { "color": "#C3C2B7" } },
                     "background": { "solid": { "color": "#1A1A19" } }, "fontSize": 10 }]
      }
    },
    "page": {
      "*": { "background": [{ "color": { "solid": { "color": "#1A1A19" } }, "transparency": 0 }] }
    }
  }
}
